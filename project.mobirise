            "paddingBottom": 1,
            "bgColor": "#fff"
          },
          "title": "Minimum Requirements for Consideration",
          "meta": "Each yacht will have specific / additional requirements - these are simply the minimums",
          "_sourceTheme": "mobirise3"
        },
        {
          "_tags": [
            "Theme"
          ],
          "_name": "msg-box5",
          "_styles": {
            "P": {
