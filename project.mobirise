            "iconFont": {
              "active": true,
              "class": "mbr-iconfont mbr-iconfont-features2",
              "name": "mobile",
              "link": "https://mobirise.com",
              "size": 0,
              "family": "et-line"
            }
          },
          "title2": "Reference Tip from Ian",
          "subtitle2": "April 25, 2022",
          "caption2": "Ask your references for permission before you pass out their names.  One - it prepares them for contactac and two - you never know if they know about a good yacht looking for crew!<br>",
          "button2": "<a data-app-btn=\"true\" href=\"https://mobirise.com\" class=\"btn btn-primary\">MORE</a>",
          "media3": {
            "iconFont": {
              "active": true,
              "class": "mbr-iconfont mbr-iconfont-features2",
              "name": "pencil",
              "link": "https://mobirise.com",
              "size": 0,
              "family": "et-line"
            }
          },
          "title3": "CV Tip from Ian",
          "subtitle3": "April 22, 2022",
          "caption3": "Don't lie on your CV. Ever. Once you are caught in a lie, it is impossible to believe anything else on your CV.",
