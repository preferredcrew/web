          },
          "title2": "Career Tip from Ian",
          "subtitle2": "October 6",
          "caption2": "Never stay on a dangerous boat. Get off immediately, no matter the consequence to your career.<br>",
          "button2": "<a data-app-btn=\"true\" href=\"https://mobirise.com\" class=\"btn btn-primary\">MORE</a>",
          "media3": {
            "iconFont": {
