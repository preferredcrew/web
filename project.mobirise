        {
          "_inherit": "features1",
          "_tags": [
            "Theme"
          ],
          "_name": "features2",
          "_styles": {
            ".striped .mbr-cards-col:nth-child(2n+1)": {
              "background-color": "#28324e"
            },
            ".mbr-cards-col:nth-child(even) .card-title": {
              "color": "#28324e"
            },
            ".mbr-cards-col:nth-child(even) .card-text": {
              "color": "#28324e"
            }
          },
          "_anchor": "features2-w",
          "_params": {
            "showImages": false,
            "showTitles": true,
            "showSubtitles": false,
            "ShowTexts": true,
            "showButtons": false,
            "columnsColor": "#28324e",
            "paddingTop": "1",
            "paddingBottom": "0",
            "columns": 4,
            "bgImageRadio": false,
            "bgImage": "@THEME_PATH@/components/_images/jumbotron.jpg",
            "parallax": true,
            "bgColorRadio": true,
            "bgColor": "#efefef",
            "bgVideoRadio": false,
            "bgVideo": {
              "url": "https://www.youtube.com/watch?v=uNCr7NdOJgw"
            },
            "overlay": false,
            "overlayColor": "#222",
            "overlayOpacity": 0.5
          },
          "media1": {
            "iconFont": {
              "active": true,
              "class": "mbr-iconfont mbr-iconfont-features2",
              "name": "desktop",
              "link": "https://mobirise.com",
              "size": 0,
              "family": "et-line"
            }
          },
          "title1": "I heard that you actually call my references, will you tell me what they say about me?",
          "subtitle1": "Bootstrap 4 has been noted",
          "caption1": "We do call them.  Our actual process is to send them an email asking permission to call and when they give us the permission we call and ask a few questions about your time working with their program. No matter what they tell us, good or bad, we do not share with the candidate.  We treat this information with great confidentiality.<br>Candidates who are not comfortable with this procedure should not send us their CV. &nbsp;If you decide at any time you are not comfortable with our policy - you can always request that we delete all documents from your file. &nbsp;Send an email to records@preferredcrew.com asking us to do so and we will delete your CV, Documents, References, Interview Notes, etc. We will only maintain your name and DOB - please note, we will be unable to open another file for you in the future. &nbsp; If a future Candidate asks us to contact you as a reference for them, we may reach out to you, but will not open a file - you may always refuse our reference request.",
          "button1": "<a data-app-btn=\"true\" href=\"https://mobirise.com\" class=\"btn btn-primary\">MORE</a>",
          "media2": {
            "iconFont": {
              "active": true,
              "class": "mbr-iconfont mbr-iconfont-features2",
              "name": "mobile",
              "link": "https://mobirise.com",
              "size": 0,
              "family": "et-line"
            }
          },
          "title2": "I’ve seen that other agencies post the wages for jobs – you don’t.  Why not?",
          "subtitle2": "One of Bootstrap 4's big points",
          "caption2": "We don’t share wages as we do not believe a crew agent adds any value to the negotiation process.  AFTER both sides have met, discussed the position, the requirements, the expectations, etc., then they should have a discussion regarding fair and appropriate wages.  From our side, we require both candidates and programs to give us their expectations as we will not bring the two sides together if there is no chance of them coming to an agreement on wages.  If a client requests that we post the wage for the position (sometimes happens for deckhand or stew positions) then we will.<br>",
          "button2": "<a data-app-btn=\"true\" href=\"https://mobirise.com\" class=\"btn btn-primary\">MORE</a>",
          "media3": {
            "iconFont": {
              "active": true,
              "class": "mbr-iconfont mbr-iconfont-features2",
              "name": "pencil",
              "link": "https://mobirise.com",
              "size": 0,
              "family": "et-line"
            }
          },
          "title3": "But what if the wages are good enough – how do you know what I want?",
          "subtitle3": "Google has a highly exhaustive list of fonts",
          "caption3": "We ask you what you are seeking.  You should remember that you are not negotiating with us when you answer our questions – you are telling us your true expectations.<br>",
          "button3": "<a data-app-btn=\"true\" href=\"https://mobirise.com\" class=\"btn btn-primary\">MORE</a>",
          "media4": {
            "iconFont": {
              "active": true,
              "class": "mbr-iconfont mbr-iconfont-features2",
              "name": "global",
              "link": "https://mobirise.com",
              "size": 0,
              "family": "et-line"
            }
          },
          "title4": "If you send me a job and I don’t like the sound of it – do I have to go on the interview to stay in your good graces?",
          "subtitle4": "Mobirise gives you the freedom to develop",
          "caption4": "You do not.  It is not your job to stay in our good graces.  If we send a job that does not appeal to you, then we are either pushing you too hard, or we have misunderstood something about your career path.  Please tell us “no” but also please tell us why so we can learn from our mistakes.<br>",
          "button4": "<a data-app-btn=\"true\" href=\"https://mobirise.com\" class=\"btn btn-primary\">MORE</a>",
          "media5": {
            "iconFont": {
              "active": true,
              "class": "mbr-iconfont mbr-iconfont-features2",
              "name": "global",
              "link": "https://mobirise.com",
              "size": 0,
              "family": "et-line"
            }
          },
          "title5": "Trendy Website Blocks",
          "subtitle5": "Choose from the large selection of blocks",
          "caption5": "Choose from the large selection of latest pre-made blocks - jumbotrons, hero images, parallax scrolling, video backgrounds, hamburger menu, sticky header and more.",
          "button5": "<a data-app-btn=\"true\" href=\"https://mobirise.com\" class=\"btn btn-primary\">MORE</a>",
          "media6": {
            "iconFont": {
              "active": true,
              "class": "mbr-iconfont mbr-iconfont-features2",
              "name": "global",
              "link": "https://mobirise.com",
              "size": 0,
              "family": "et-line"
            }
          },
          "title6": "Host Anywhere",
          "subtitle6": "Don't limit yourself to just one platform",
          "caption6": "Publish your website to a local drive, FTP or host on Amazon S3, Google Drive, Github. Don't limit yourself to just one platform or service provider.",
          "button6": "<a data-app-btn=\"true\" href=\"https://mobirise.com\" class=\"btn btn-primary\">MORE</a>",
